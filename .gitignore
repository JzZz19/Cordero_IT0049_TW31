# Do not upload the local environment configuration
.env

# CodeIgniter temporary files
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*

# Keep the directories in Git
!writable/cache/index.html
!writable/debugbar/index.html
!writable/logs/index.html
!writable/session/index.html
!writable/uploads/index.html

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
*.zip